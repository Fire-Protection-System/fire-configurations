MONGO_CONNECTION=mongodb://mongo:27017/configurations
MONGO_INITDB_DATABASE=configurations
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq
MONGO_PORT=27017
SIMULATOR_PORT=5000
BACKEND_PORT=8181
CONFIG_PORT=31415
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
BUILD_ENV=development
SPRING_PROFILE=dev
LOG_PATTERN=%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} [%level] %logger{36} - %msg%n
SONAR_HOST_URL=http://sonarqube:9000
LOG_DIRECTORY=/var/log/fire-configuration
